{
  "name": "@pw/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --watchman=false"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-file-system": "~19.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-network": "~8.0.0",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "~5.6.0",
    "@pw/shared": "file:../../packages/shared"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "@testing-library/react-native": "^13.3.3",
    "react-test-renderer": "19.1.0",
    "@types/jest": "^29.5.14"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s",
      "**/__tests__/**/*.test.tsx"
    ],
    "clearMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
